# Copy to .env and fill in secrets locally. Never commit .env.
PORT=
CHAT_SERVICE=
MONGODB_URI=
REDIS_URL=

# At least one chat model key is required.
GROQ_API_KEY=
# GOOGLE_API_KEY is also accepted for compatibility with this workspace's existing .env.
GOOGLE_API_KEY=

# Pollinations AI image generation. Keep the secret key only in the backend environment.
POLLINATIONS_API_KEY=
# Optional; defaults to Pollinations' raster Flux image model.
POLLINATIONS_IMAGE_MODEL=flux

# ImageKit stores generated images, generated presentations, and uploaded PDFs.
IMAGE_KIT_PRIVATE_KEY=

# Required only for Auto/web search and Search mode.
TAVILY_API_KEY=

# Optional model overrides
GROQ_MODEL=
GOOGLE_MODEL=
