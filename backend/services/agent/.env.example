# Copy to .env and fill in secrets locally. Never commit .env.
PORT=
CHAT_SERVICE=
MONGODB_URI=
REDIS_URL=

# At least one chat model key is required.
GROQ_API_KEY=
# GOOGLE_API_KEY is also accepted for compatibility with this workspace's existing .env.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Cloud image fallback is billed per image; enable only on the hosted service after reviewing pricing.
GEMINI_IMAGE_FALLBACK_ENABLED=false

# Free local photorealistic image generation through ComfyUI and Stable Diffusion.
COMFYUI_DIRECTORY=
COMFYUI_URL=http://127.0.0.1:8188
LOCAL_IMAGE_RELAY_PORT=8190
# Use the same random 48+ character secret in Render's NEXORA_LOCAL_IMAGE_TOKEN setting.
NEXORA_LOCAL_IMAGE_TOKEN=
COMFYUI_PORT=8188
COMFYUI_CHECKPOINT=Realistic_Vision_V5.1_fp16-no-ema.safetensors
COMFYUI_VAE=vae-ft-mse-840000-ema-pruned.safetensors
LOCAL_IMAGE_WIDTH=768
LOCAL_IMAGE_HEIGHT=768
LOCAL_IMAGE_STEPS=26

# ImageKit stores generated images, generated presentations, and uploaded PDFs.
IMAGE_KIT_PRIVATE_KEY=

# Required only for Auto/web search and Search mode.
TAVILY_API_KEY=

# Optional model overrides
GROQ_MODEL=
GOOGLE_MODEL=
