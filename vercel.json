{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend/vite-project ci",
  "buildCommand": "npm --prefix frontend/vite-project run build",
  "outputDirectory": "frontend/vite-project/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://biographies-navigator-roman-onto.trycloudflare.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
